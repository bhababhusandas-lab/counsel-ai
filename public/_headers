# Never cache the HTML shell, so a new deploy reaches every visitor immediately.
# (The JS/CSS it references are content-hashed, so they are safe to cache forever.)
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

# Hashed, immutable build assets — cache aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/home
  Cache-Control: no-cache, must-revalidate
/home.html
  Cache-Control: no-cache, must-revalidate
/services
  Cache-Control: no-cache, must-revalidate
/services.html
  Cache-Control: no-cache, must-revalidate
/work
  Cache-Control: no-cache, must-revalidate
/work.html
  Cache-Control: no-cache, must-revalidate
/portfolio
  Cache-Control: no-cache, must-revalidate
/portfolio.html
  Cache-Control: no-cache, must-revalidate
/about
  Cache-Control: no-cache, must-revalidate
/about.html
  Cache-Control: no-cache, must-revalidate
/contact
  Cache-Control: no-cache, must-revalidate
/contact.html
  Cache-Control: no-cache, must-revalidate

/iso-9001-certificate.pdf
  Content-Disposition: inline
  Content-Type: application/pdf
