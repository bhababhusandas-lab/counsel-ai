# Counsel AI backend settings. Copy to server/.env and fill in. Never commit .env.
PORT=8080

# ── Chat model (required): any OpenAI-compatible provider ────────────
# Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=openai/gpt-oss-120b
# OpenAI:             LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
# Or leave these empty and set XAI_API_KEY to use Grok (the default).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
XAI_API_KEY=

# Voice input (optional): Whisper speech-to-text
OPENAI_API_KEY=

# ── Law search indexes ───────────────────────────────────────────────
# Folders (colon-separated) searched before server/data for the index files.
RAG_DATA_DIRS=
# Optional S3 download of indexes at startup
INDEX_S3_BUCKET=
INDEX_S3_PREFIX=counselai-indexes/
INDEX_S3_REGION=

# ── Accounts and saved cases (optional) ──────────────────────────────
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
GOOGLE_CLIENT_ID=
# DynamoDB table names. Set these to your existing table names to keep using them.
CASES_TABLE=counselai-cases
EVENTS_TABLE=counselai-calendar-events

# ── Email alerts (optional) ──────────────────────────────────────────
NOTIFY_FROM_EMAIL=
NOTIFY_FROM_PASS=
ADMIN_NOTIFY_EMAIL=

# Evaluation script (server/eval/run.mjs) target
EVAL_API_URL=
